# Server-only variables. Never add VITE_ to either Supabase variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_SERVER_KEY
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_ADMIN_PASSWORD

# Optional legacy alternative to SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
