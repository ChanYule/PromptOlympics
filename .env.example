# Never commit .env or prefix any secret with VITE_.
NODE_ENV=production
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_SERVER_KEY
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-3.6-flash
ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD_OF_AT_LEAST_16_CHARACTERS
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
APP_ORIGIN=https://YOUR_RENDER_SERVICE.onrender.com
AI_CONCURRENCY=6
MAX_QUEUE=150
MAX_STORIES_PER_PARTICIPANT=5
DAILY_GENERATION_BUDGET=1000
AI_TIMEOUT_MS=20000
# Explicit development only; remove SUPABASE_URL and SUPABASE_SECRET_KEY to use this:
# NODE_ENV=development
# STORAGE_MODE=local
# LOCAL_DATA_PATH=data/development-v2.json
# AI_MODE=mock
# Optional legacy alternative:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
